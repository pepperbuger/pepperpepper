# .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다.

# Ondo Perps API 키: 거래+조회 권한만, 출금 권한 없음, IP 화이트리스트 등록
ONDO_API_KEY_ID=ondoKeyId_
ONDO_API_SECRET=ondoApiSecret_

# Lighter API 키 (L1 지갑 개인키가 아님)
LIGHTER_API_KEY_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4

# 알림 (선택): 텔레그램 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
